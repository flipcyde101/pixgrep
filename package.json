{
  "name": "pixgrep",
  "version": "0.1.0",
  "description": "Offline ripgrep for screenshots and images with SQLite FTS5 incremental indexing, OS-native OCR backends, and inline terminal previews with neon-green match bounding boxes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flipcyde101/pixgrep.git"
  },
  "homepage": "https://github.com/flipcyde101/pixgrep#readme",
  "bugs": {
    "url": "https://github.com/flipcyde101/pixgrep/issues"
  },
  "bin": {
    "pixgrep": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "ocr",
    "ripgrep",
    "screenshots",
    "sqlite-fts5",
    "terminal",
    "tui",
    "kitty-graphics",
    "offline",
    "search",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
